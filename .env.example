# ============================================
# EVENT MANAGEMENT PLATFORM - ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env.local for local development
# For Vercel: Project → Settings → Environment Variables

# --------------------------------------------
# REQUIRED - Database (Neon PostgreSQL)
# --------------------------------------------
# Get from: https://console.neon.tech → Your Project → Connection Details
DATABASE_URL="postgresql://username:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"
# Optional unpooled connection (for migrations)
DATABASE_URL_UNPOOLED="postgresql://username:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# --------------------------------------------
# REQUIRED - Authentication
# --------------------------------------------
# Generate a strong random string (min 32 characters)
# Example: openssl rand -base64 32
AUTH_SECRET="your-super-secret-auth-key-change-this-in-production-min-32-chars"
SESSION_SECRET="your-super-secret-session-key-change-this-in-production-min-32-chars"

# --------------------------------------------
# REQUIRED - App URL
# --------------------------------------------
# After deploying to Vercel, set this to your production URL
# Example: https://your-event.vercel.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --------------------------------------------
# REQUIRED - Resend Email
# --------------------------------------------
# Get from: https://resend.com → API Keys
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Must be a verified domain or use onboarding@resend.dev for testing
RESEND_FROM_EMAIL="onboarding@resend.dev"
RESEND_FROM_NAME="Event Platform"

# --------------------------------------------
# REQUIRED - Vercel Blob (Image Storage)
# --------------------------------------------
# Automatically available on Vercel when you enable Blob storage
# Or create a store in Vercel Dashboard → Storage → Blob
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# --------------------------------------------
# OPTIONAL - Initial Super Admin (used by setup)
# --------------------------------------------
# These are only used during first-time setup
INITIAL_ADMIN_EMAIL="admin@example.com"
INITIAL_ADMIN_PASSWORD="ChangeMe123!"
INITIAL_ADMIN_NAME="Super Admin"
